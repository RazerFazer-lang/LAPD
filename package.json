{
  "name": "american-dispatch",
  "version": "1.2.0-alpha",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build && node scripts/build-server.mjs",
    "start": "node dist/server/index.js",
    "preview": "node dist/server/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "maplibre-gl": "6.7.0",
    "react": "latest",
    "react-dom": "latest",
    "ws": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/ws": "latest",
    "esbuild": "0.28.2",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": "24.x"
  }
}
