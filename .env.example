# Tokens are required before a browser can claim a dispatch role.
DISPATCH_TOKEN=replace-with-a-long-random-token
# Required only for the Administrator role.
ADMIN_TOKEN=replace-with-a-different-long-random-token
# Optional persistent, versioned multiplayer save location.
SAVE_FILE=data/game-state.json
# Optional browser build/runtime endpoint, e.g. ws://localhost:8787
VITE_SERVER_URL=ws://localhost:8787
